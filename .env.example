# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_MEDIA_BUCKET=autoreel-publishing

# Server
ADMIN_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
STORAGE_DIR=./storage

# Instagram / Meta Login for Business
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_LOGIN_CONFIG_ID=your-meta-login-config-id
META_GRAPH_API_VERSION=v26.0
META_REDIRECT_URI=

# Optional YouTube OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Video processing
MAX_STORAGE_GB=10
MAX_UPLOAD_MB=500
MAX_TRANSCODE_MB=500
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Cleanup
TEMP_RETENTION_HOURS=2
PUBLISHED_RETENTION_HOURS=24
FAILED_RETENTION_HOURS=48
CLEANUP_INTERVAL_MINUTES=15
